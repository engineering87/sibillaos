#!/usr/bin/env bash
# sibilla-key: manage the gateway API keys.
set -euo pipefail

KEYS_DIR=/etc/llmd/apikeys.d
DEFAULT_KEY=/etc/llmd/apikey

usage() {
  cat <<USAGE
usage: sibilla-key COMMAND

  list           show configured keys (names and prefixes, not keys)
  add NAME       create an extra key; prints it once, on the last line
  revoke NAME    remove an extra key (rotate the default instead)
  rotate [NAME]  replace a key; default key when NAME is omitted;
                 prints the new key once, on the last line
  usage [DAYS]   traffic seen by the gateway from the structured
                 access log (default: last 7 days): requests, status
                 classes, top endpoints, activity by day

Every change takes effect immediately: clients using a revoked or
rotated key get 401 on their next request.
USAGE
  exit 1
}

need_root() { [[ $EUID -eq 0 ]] || { echo "run as root (sudo)" >&2; exit 1; }; }

gen_key() { head -c32 /dev/urandom | base64 | tr -d '=+/' | cut -c1-40; }

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; }

render_restart() {
  /usr/lib/llmd/llmd-keys-render
  systemctl restart caddy.service
}

prefix_of() { cut -c1-6 "$1" 2>/dev/null || true; }

cmd_list() {
  need_root
  if [[ -s "$DEFAULT_KEY" ]]; then
    echo "default  $(prefix_of "$DEFAULT_KEY")... (in $DEFAULT_KEY)"
  fi
  if [[ -d "$KEYS_DIR" ]]; then
    local f
    for f in "$KEYS_DIR"/*; do
      [[ -f "$f" ]] || continue
      echo "$(basename "$f")  $(prefix_of "$f")..."
    done
  fi
}

cmd_add() {
  need_root
  local name="$1"
  valid_name "$name" || { echo "invalid name (lowercase, digits, dashes)" >&2; exit 1; }
  [[ "$name" != "default" ]] || { echo "'default' is reserved; use rotate" >&2; exit 1; }
  [[ ! -e "$KEYS_DIR/$name" ]] || { echo "key '$name' already exists" >&2; exit 1; }
  mkdir -p "$KEYS_DIR"
  chmod 700 "$KEYS_DIR"
  local key
  key=$(gen_key)
  (umask 077; printf '%s\n' "$key" > "$KEYS_DIR/$name")
  render_restart
  echo "key '$name' added; store it now, it will not be shown again:"
  echo "$key"
}

cmd_revoke() {
  need_root
  local name="$1"
  [[ "$name" != "default" ]] || { echo "the default key cannot be revoked, rotate it" >&2; exit 1; }
  [[ -f "$KEYS_DIR/$name" ]] || { echo "no key named '$name'" >&2; exit 1; }
  rm -f "$KEYS_DIR/$name"
  render_restart
  echo "key '$name' revoked"
}

cmd_rotate() {
  need_root
  local name="$1"
  local target key
  if [[ "$name" == "default" ]]; then
    target="$DEFAULT_KEY"
  else
    target="$KEYS_DIR/$name"
    [[ -f "$target" ]] || { echo "no key named '$name'" >&2; exit 1; }
  fi
  key=$(gen_key)
  (umask 077; printf '%s\n' "$key" > "$target")
  render_restart
  echo "key '$name' rotated; the old key is rejected from now on:"
  echo "$key"
}

ACCESS_LOG="${LLMD_ACCESS_LOG:-/var/log/caddy/sibilla-access.log}"

cmd_usage_stats() {
  need_root
  # shellcheck source=/dev/null
  . /usr/lib/llmd/sibilla-style
  local days="${1:-7}"
  [[ "$days" =~ ^[0-9]+$ && "$days" -ge 1 ]] || { echo "DAYS must be a positive number" >&2; exit 1; }
  [[ -r "$ACCESS_LOG" ]] || { echo "no access log at $ACCESS_LOG yet (the gateway writes it on first request)" >&2; exit 1; }
  s_hdr "key usage"
  local since
  since=$(date -d "-$days days" +%s)
  # one jq pass computes everything; the log is JSON lines with ts
  # (epoch), status, request.uri. Keys never appear in the log: caddy
  # redacts Authorization, which is exactly how we want it.
  local stats
  stats=$(jq -s --argjson since "$since" '
    [ .[] | select(.ts >= $since) ] as $r |
    {
      total: ($r | length),
      ok:    ([ $r[] | select(.status >= 200 and .status < 300) ] | length),
      auth:  ([ $r[] | select(.status == 401) ] | length),
      err4:  ([ $r[] | select(.status >= 400 and .status < 500 and .status != 401) ] | length),
      err5:  ([ $r[] | select(.status >= 500) ] | length),
      first: ($r | map(.ts) | min),
      last:  ($r | map(.ts) | max),
      top:   ($r | group_by(.request.uri) | map({u: .[0].request.uri, n: length})
              | sort_by(-.n) | .[0:5]),
      days:  ($r | group_by(.ts | strftime("%Y-%m-%d")) 
              | map({d: (.[0].ts | strftime("%Y-%m-%d")), n: length}) | sort_by(.d))
    }' "$ACCESS_LOG" 2>/dev/null) || { echo "could not parse the access log" >&2; exit 1; }
  local total
  total=$(echo "$stats" | jq -r '.total')
  s_kv "window:" "last $days day(s)"
  s_kv "requests:" "$total"
  if [[ "$total" -gt 0 ]]; then
    s_kv "status:" "$(echo "$stats" | jq -r '"\(.ok) ok, \(.auth) unauthorized, \(.err4) client err, \(.err5) server err"')"
    s_kv "first:" "$(date -d "@$(echo "$stats" | jq -r '.first | floor')" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '-')"
    s_kv "last:" "$(date -d "@$(echo "$stats" | jq -r '.last | floor')" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '-')"
    s_rule
    echo "top endpoints:"
    echo "$stats" | jq -r '.top[] | "  \(.n)	\(.u)"'
    s_rule
    echo "by day:"
    echo "$stats" | jq -r '.days[] | "  \(.d)  \(.n)"'
  fi
  s_rule
  echo "configured keys (names only; sibilla key list for prefixes):"
  echo "  default ($DEFAULT_KEY)"
  if [[ -d "$KEYS_DIR" ]]; then
    for f in "$KEYS_DIR"/*; do
      [[ -f "$f" ]] || continue
      echo "  $(basename "$f") (added $(date -r "$f" '+%Y-%m-%d'))"
    done
  fi
  echo
  echo "per-key attribution needs a log field the archive caddy (2.6)"
  echo "cannot write; recorded with the rate-limit pressure in the"
  echo "architecture log. The log never contains the keys themselves."
}

case "${1:-}" in
  usage-stats|usage) shift; cmd_usage_stats "${1:-}" ;;
  list)   cmd_list ;;
  add)    [[ $# -ge 2 ]] || usage; cmd_add "$2" ;;
  revoke) [[ $# -ge 2 ]] || usage; cmd_revoke "$2" ;;
  rotate) cmd_rotate "${2:-default}" ;;
  *)      usage ;;
esac
