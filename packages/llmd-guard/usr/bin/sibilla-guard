#!/usr/bin/env bash
# sibilla-guard: a guard model in front of chat completions, on or off.
set -euo pipefail

STATE=/etc/llmd/guard
CATALOG=/usr/share/llmd/models.json
MODEL_DIR=/var/lib/llmd/models/guard
MODEL_FILE="$MODEL_DIR/qwen3guard-gen-0.6b-q8_0.gguf"
MODEL_ID="hf.co/mradermacher/Qwen3Guard-Gen-0.6B-GGUF"
MODEL_URL="https://huggingface.co/mradermacher/Qwen3Guard-Gen-0.6B-GGUF/resolve/main/Qwen3Guard-Gen-0.6B.Q8_0.gguf"

usage() {
  cat <<USAGE
usage: sibilla-guard COMMAND

  enable    screen every chat request with the guard model
  disable   remove the guard stage
  status    show whether the guard is enabled

When enabled, /v1/chat/completions passes through a loopback guard
stage: the last user message is classified by Qwen3Guard (the official
safety template travels inside the GGUF) and requests judged Unsafe
are refused with an explicit error; everything else reaches the
engine untouched, streaming included. The guard fails closed. Set
LLMD_GUARD_STRICT=1 in the unit to also block Controversial verdicts.
Details in docs/guard.md in the SibillaOS repository.
USAGE
  exit 1
}

need_root() { [[ $EUID -eq 0 ]] || { echo "run as root (sudo)" >&2; exit 1; }; }

check_catalog() {
  local rc=0
  /usr/lib/llmd/llmd-catalog-verify "$CATALOG" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -eq 1 ]]; then
    echo "REFUSING to use the catalog: signature verification failed" >&2
    exit 1
  fi
}

ensure_model() {
  local want have
  want=$(jq -r --arg id "$MODEL_ID" \
    '.models[] | select(.id == $id) | .digests.Q8_0 // empty' "$CATALOG")
  [[ -n "$want" ]] || { echo "no digest for $MODEL_ID in the catalog" >&2; exit 1; }
  if [[ -f "$MODEL_FILE" ]]; then
    have="sha256:$(sha256sum "$MODEL_FILE" | cut -d' ' -f1)"
    if [[ "$have" == "$want" ]]; then
      echo "guard model already present and verified"
      return 0
    fi
    echo "REFUSING to keep $MODEL_FILE: sha256 does not match the catalog digest" >&2
    exit 1
  fi
  mkdir -p "$MODEL_DIR"
  echo "downloading the guard model (~805 MB, verified after download) ..."
  local tmp
  tmp=$(mktemp -p "$MODEL_DIR")
  local -a auth=()
  [[ -n "${HF_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $HF_TOKEN")
  curl -fL --retry 3 "${auth[@]}" -o "$tmp" "$MODEL_URL" \
    || { rm -f "$tmp"; echo "download failed" >&2; exit 1; }
  have="sha256:$(sha256sum "$tmp" | cut -d' ' -f1)"
  if [[ "$have" != "$want" ]]; then
    rm -f "$tmp"
    echo "REFUSING to keep the download: sha256 does not match the catalog digest" >&2
    exit 1
  fi
  mv "$tmp" "$MODEL_FILE"
  chmod 644 "$MODEL_FILE"
  echo "guard model verified: $want"
}

render_restart() {
  /usr/lib/llmd/llmd-gateway-render
  systemctl reload-or-restart caddy.service
}

case "${1:-}" in
  enable)
    need_root
    check_catalog
    ensure_model
    echo on > "$STATE"
    systemctl enable --now llmd-guard-model.service
    systemctl enable --now llmd-guard-proxy.service
    render_restart
    echo "guard enabled: chat requests judged Unsafe are refused"
    echo "(the verdict model runs on loopback; nothing leaves the machine)"
    ;;
  disable)
    need_root
    echo off > "$STATE"
    systemctl disable --now llmd-guard-proxy.service
    systemctl disable --now llmd-guard-model.service
    systemctl reset-failed llmd-guard-proxy.service llmd-guard-model.service 2>/dev/null || true
    render_restart
    echo "guard disabled: chat requests go straight to the engine again"
    ;;
  status)
    echo "guard: $(cat "$STATE" 2>/dev/null || echo off)"
    ;;
  *) usage ;;
esac
