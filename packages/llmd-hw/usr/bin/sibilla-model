#!/usr/bin/env bash
# sibilla-model: list, pick and switch the model served by SibillaOS.
set -euo pipefail

CATALOG=/usr/share/llmd/models.json
ENGINE=$(cat /etc/llmd/engine 2>/dev/null || echo ollama)
CURRENT=$(cat /etc/llmd/model 2>/dev/null || true)

usage() {
  cat <<EOF
usage: sibilla-model COMMAND

  status         show engine, current model and API endpoint
  list           curated models for this machine, plus llmfit picks
  use MODEL_ID   download MODEL_ID and make it the served model
  pull MODEL_ID  download and verify MODEL_ID without switching
                 (embedding models are served this way)
  import FILE    bring a model in from a GGUF file instead of the
                 network (USB stick, shared drive); the file must
                 match a digest in the signed catalog. --use serves it
  info [MODEL]   the model's card: parameters, quantization, context
                 length, embedding width, plus catalog and runtime
                 state (defaults to the served model)
  rm MODEL_ID    remove a downloaded model (refuses the served one)
  prune          remove every downloaded model except the served one
  warm on|off    keep the served model resident instead of unloading
                 it after idle: the first request after a quiet hour
                 stops paying the reload. Costs the RAM while idle
  cache q8|default
                 quantize the KV cache to q8_0 (flash attention
                 enabled with it): half the context memory for a
                 negligible quality cost. 'default' reverts to f16
  context [N]    show or set the context window (ollama engine).
                 Left ungoverned, the engine sizes its KV cache from
                 visible memory, which on unified-memory machines
                 reserves tens of GB nobody asked for. Default 8192;
                 'context default' removes the override
EOF
  exit 1
}

# drop-ins apply in lexicographic order and the last assignment of a
# variable wins: this file must sort AFTER hardening.conf or the
# default would silently override the override
CONTEXT_OVERRIDE=/etc/systemd/system/ollama.service.d/zz-context.conf
CONTEXT_DEFAULT=8192

context_current() {
  local v
  v=$(sed -n 's/^Environment=OLLAMA_CONTEXT_LENGTH=//p' "$CONTEXT_OVERRIDE" 2>/dev/null | head -1)
  echo "${v:-$CONTEXT_DEFAULT}"
}

# a deliberate admin command must not be stopped by the unit's own
# start-limit accounting: two governor commands back to back are a
# legitimate sequence, not a crash loop (the caddy lesson, adapted to
# a unit that reads its environment only at start)
restart_engine() {
  systemctl daemon-reload
  systemctl reset-failed ollama.service 2>/dev/null || true
  systemctl restart ollama.service
}

WARM_DROPIN=/etc/systemd/system/ollama.service.d/zz-warm.conf
CACHE_DROPIN=/etc/systemd/system/ollama.service.d/zz-cache.conf

cmd_warm() {
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    if [[ -f "$WARM_DROPIN" ]]; then echo "warm: on (the served model stays resident)"; else echo "warm: off (the engine unloads after ~5m idle)"; fi
    return 0
  fi
  need_root
  [[ "$ENGINE" == "ollama" ]] || { echo "warm is governed on the ollama engine; vllm is always resident" >&2; exit 1; }
  case "$want" in
    on)
      mkdir -p "$(dirname "$WARM_DROPIN")"
      {
        echo "# SibillaOS: the oracle does not sleep (sibilla model warm)"
        echo "[Service]"
        echo "Environment=OLLAMA_KEEP_ALIVE=-1"
      } > "$WARM_DROPIN"
      restart_engine
      echo "warm on: the served model stays resident after idle"
      echo "(the trade: its RAM stays taken while the machine is quiet)"
      ;;
    off)
      rm -f "$WARM_DROPIN"
      restart_engine
      echo "warm off: the engine unloads idle models again (~5m)"
      ;;
    *) echo "usage: sibilla model warm on|off" >&2; exit 1 ;;
  esac
}

cmd_cache() {
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    if [[ -f "$CACHE_DROPIN" ]]; then echo "cache: q8_0 (flash attention on, half the context memory)"; else echo "cache: f16 (default)"; fi
    return 0
  fi
  need_root
  [[ "$ENGINE" == "ollama" ]] || { echo "the kv cache is governed on the ollama engine" >&2; exit 1; }
  case "$want" in
    q8|q8_0)
      mkdir -p "$(dirname "$CACHE_DROPIN")"
      {
        echo "# SibillaOS: quantized KV cache (sibilla model cache)"
        echo "# flash attention is required for the quantized cache and"
        echo "# is enabled with it; if generation misbehaves on your"
        echo "# hardware, revert with: sibilla model cache default"
        echo "[Service]"
        echo "Environment=OLLAMA_FLASH_ATTENTION=1"
        echo "Environment=OLLAMA_KV_CACHE_TYPE=q8_0"
      } > "$CACHE_DROPIN"
      restart_engine
      echo "cache: q8_0 with flash attention - half the context memory,"
      echo "negligible quality cost; revert with: sibilla model cache default"
      ;;
    default|f16)
      rm -f "$CACHE_DROPIN"
      restart_engine
      echo "cache back to f16 (flash attention back to the engine default)"
      ;;
    *) echo "usage: sibilla model cache q8|default" >&2; exit 1 ;;
  esac
}

cmd_context() {
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    echo "context: $(context_current) tokens (default $CONTEXT_DEFAULT; set with: sibilla model context N)"
    return 0
  fi
  need_root
  [[ "$ENGINE" == "ollama" ]] || { echo "context is governed on the ollama engine; vllm sizes per request" >&2; exit 1; }
  if [[ "$want" == "default" ]]; then
    rm -f "$CONTEXT_OVERRIDE"
    restart_engine
    echo "context back to the default ($CONTEXT_DEFAULT tokens)"
    return 0
  fi
  if ! [[ "$want" =~ ^[0-9]+$ && "$want" -ge 512 ]]; then
    echo "context must be a number of tokens (>= 512) or 'default'" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$CONTEXT_OVERRIDE")"
  {
    echo "# SibillaOS: deliberate context override (sibilla model context)"
    echo "[Service]"
    echo "Environment=OLLAMA_CONTEXT_LENGTH=$want"
  } > "$CONTEXT_OVERRIDE"
  restart_engine
  echo "context: $want tokens (KV cache grows with it; bigger context, more RAM)"
}

need_root() { [[ $EUID -eq 0 ]] || { echo "run as root (sudo)" >&2; exit 1; }; }

# Large-tier guard: a model bigger than the machine's RAM does not run
# slowly, it freezes the box in swap - and the download alone is tens
# of gigabytes. Fail closed BEFORE pulling, with the numbers stated.
# No --force: a machine below the floor gains nothing from one.
check_ram_floor() {
  local model="$1" min_ram ram_gb
  # match the exact id, the base, or a bare name against a tagged
  # entry ("gpt-oss" must hit "gpt-oss:120b"): no tag-omission bypass
  min_ram=$(jq -r --arg id "${model%%:*}" --arg full "$model" \
    '[.models[] | select(.tier? == "large")
      | select(.id == $id or .id == $full or (.id | startswith($full + ":")) or (.id | startswith($id + ":")))
      | .min_ram_gb][0] // empty' \
    "$CATALOG")
  [[ -n "$min_ram" ]] || return 0
  ram_gb=$(awk '/MemTotal/ {print int($2/1024/1024)}' /proc/meminfo 2>/dev/null || echo 0)
  if [[ "$ram_gb" -lt "$min_ram" ]]; then
    echo "REFUSING: $model needs ~${min_ram} GB of RAM and this machine has ${ram_gb} GB." >&2
    echo "A model past the RAM floor does not run slowly, it freezes the box in swap." >&2
    echo "See 'sibilla model list' for what fits this machine." >&2
    exit 1
  fi
  echo "large model: ~${min_ram} GB RAM needed, ${ram_gb} GB present; layers beyond the GPU spill to RAM"
  echo "generation will be slower than a model that fits the GPU; the real split shows in: sibilla status"
}

# catalog trust: a broken signature always aborts; unsigned builds
# (no project key yet) warn and continue
check_catalog() {
  local rc=0
  /usr/lib/llmd/llmd-catalog-verify "$CATALOG" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -eq 1 ]]; then
    echo "REFUSING to use the catalog: signature verification failed" >&2
    exit 1
  fi
}

cmd_status() {
  echo "engine:  $ENGINE"
  echo "model:   ${CURRENT:-none selected}"
  echo "api:     http://$(hostname -I 2>/dev/null | awk '{print $1}'):8080 (key in /etc/llmd/apikey)"
}

cmd_list() {
  check_catalog
  echo "curated models for engine '$ENGINE' (current: ${CURRENT:-none}):"
  jq -r --arg e "$ENGINE" \
    '.models[] | select(.engines[]? == $e) | select(.role? != "embedding") | select(.tier? != "large") | "  " + .id + "  [" + .family + ", " + .license + "]"' \
    "$CATALOG"
  if jq -e --arg e "$ENGINE" \
       '[.models[] | select(.engines[]? == $e) | select(.tier? == "large")] | length > 0' \
       "$CATALOG" >/dev/null; then
    local ram_gb
    ram_gb=$(awk '/MemTotal/ {print int($2/1024/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    echo
    echo "large models (bigger than your GPU: layers spill to RAM; this machine: ${ram_gb} GB):"
    jq -r --arg e "$ENGINE" \
      '.models[] | select(.engines[]? == $e) | select(.tier? == "large") | "  " + .id + "  [" + .family + ", " + .license + "]  needs ~" + (.min_ram_gb|tostring) + " GB RAM"' \
      "$CATALOG"
  fi
  if jq -e --arg e "$ENGINE" \
       '[.models[] | select(.engines[]? == $e) | select(.role? == "embedding")] | length > 0' \
       "$CATALOG" >/dev/null; then
    echo
    echo "embedding models (serve /v1/embeddings; get one with: sibilla model pull ID:QUANT):"
    jq -r --arg e "$ENGINE" \
      '.models[] | select(.engines[]? == $e) | select(.role? == "embedding") | "  " + .id + "  [" + .family + ", " + .license + "]"' \
      "$CATALOG"
  fi
  if command -v llmfit >/dev/null 2>&1; then
    echo
    echo "llmfit recommendations for this hardware:"
    llmfit recommend --json --limit 5 2>/dev/null \
      | jq -r '.. | objects | .model? // empty' 2>/dev/null | head -5 | sed 's/^/  /' \
      || echo "  (llmfit recommendation unavailable)"
  fi
}

cmd_use() {
  need_root
  check_catalog
  local model="$1"
  # embedding models answer /v1/embeddings; serving one as the chat
  # default would give every client an API that cannot chat
  local role
  role=$(jq -r --arg id "${model%%:*}" \
    '.models[] | select(.id == $id) | .role? // empty' "$CATALOG")
  if [[ "$role" == "embedding" ]]; then
    echo "$model is an embedding model and cannot be the served chat model." >&2
    echo "download it with: sibilla model pull $model" >&2
    echo "then call /v1/embeddings with it; the chat model stays in place" >&2
    exit 1
  fi
  # a catalog entry that no current engine serves (e.g. the speech
  # model, owned by sibilla speech) must not reach the engine's pull
  if jq -e --arg id "${model%%:*}" --arg e "$ENGINE" \
       '[.models[] | select(.id == $id)] | length > 0 and ([.[] | select(.engines[]? == $e)] | length == 0)' \
       "$CATALOG" >/dev/null; then
    echo "$model is not served by the $ENGINE engine." >&2
    [[ "$role" == "speech" ]] && echo "it is the speech model: sudo sibilla speech enable manages it" >&2
    [[ "$role" == "reranker" ]] && echo "it is the rerank model: sudo sibilla rerank enable manages it" >&2
    exit 1
  fi
  check_ram_floor "$model"
  # the ollama CLI panics without HOME when run over ssh/sudo
  export HOME="${HOME:-/root}"
  case "$ENGINE" in
    ollama)
      # a model already in the local store (brought in by sibilla
      # model import on an air-gapped machine, or pulled earlier)
      # serves without touching the network; refreshing a pinned,
      # digest-checked artifact is not something a pull should do
      # silently anyway
      if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -Fxq "$model"; then
        ollama pull "$model"
      fi
      # digest check against the catalog: a recorded digest that does
      # not match means the artifact is not the reviewed one; refuse
      local vrc=0
      /usr/lib/llmd/llmd-model-verify "$model" || vrc=$?
      if [[ "$vrc" -eq 1 ]]; then
        echo "REFUSING to serve $model: pulled artifact does not match the catalog digest" >&2
        exit 1
      fi
      ;;
    vllm)
      echo "LLMD_MODEL=$model" > /etc/llmd/vllm.env
      systemctl restart vllm.service
      ;;
  esac
  echo "$model" > /etc/llmd/model
  echo "now serving: $model"
}

# Download and verify without switching what is served: how embedding
# models arrive, and useful to pre-stage a chat model before a switch.
cmd_pull() {
  need_root
  check_catalog
  local model="$1"
  [[ "$ENGINE" == "ollama" ]] || {
    echo "pull supports the ollama engine; vllm downloads at container start" >&2
    exit 1
  }
  check_ram_floor "$model"
  # the ollama CLI panics without HOME when run over ssh/sudo
  export HOME="${HOME:-/root}"
  if ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -Fxq "$model"; then
    echo "already local: $model"
  else
    ollama pull "$model"
  fi
  local vrc=0
  /usr/lib/llmd/llmd-model-verify "$model" || vrc=$?
  if [[ "$vrc" -eq 1 ]]; then
    echo "REFUSING to keep $model: pulled artifact does not match the catalog digest" >&2
    ollama rm "$model" 2>/dev/null || true
    exit 1
  fi
  echo "pulled: $model (the served chat model is unchanged: ${CURRENT:-none})"
}

# Offline model delivery: identify the file by its sha256 against the
# per-quant digests in the signed catalog, and refuse anything the
# catalog does not know. The whole point of the air-gapped path is
# that a USB stick is a reviewable delivery channel: identification
# and integrity come from the same signed record, so there is nothing
# to take on faith and no --force to bypass it.
cmd_import() {
  need_root
  check_catalog
  local file="$1" serve="${2:-}"
  [[ -f "$file" ]] || { echo "no such file: $file" >&2; exit 1; }
  # the FROM in the temporary Modelfile resolves relative paths
  # against the Modelfile's own directory, so make the path absolute
  file=$(realpath "$file")
  [[ "$ENGINE" == "ollama" ]] || {
    echo "import supports the ollama engine; vllm models are directories, not single files" >&2
    exit 1
  }
  echo "hashing $(du -h "$file" | cut -f1) ..."
  local hex match
  hex=$(sha256sum "$file" | cut -d' ' -f1)
  # registry entries carry their tag inside the id ("gpt-oss:120b",
  # digest key "120b"), so appending the key would double it
  match=$(jq -r --arg d "sha256:$hex" \
    '.models[] | .id as $id | (.digests // {}) | to_entries[] | select(.value == $d)
     | .key as $k | if ($id | endswith(":" + $k)) then $id else $id + ":" + $k end' \
    "$CATALOG")
  if [[ -z "$match" ]]; then
    echo "REFUSING to import: sha256:$hex matches no digest in the catalog." >&2
    echo "Only reviewed artifacts are importable. If this is a legitimate" >&2
    echo "catalog model, refresh the digests (tools/update-digests.sh) and" >&2
    echo "update the machine; otherwise download through: sibilla model use" >&2
    exit 1
  fi
  echo "identified: $match"
  # the ollama CLI panics without HOME when run over ssh/sudo
  export HOME="${HOME:-/root}"
  local modelfile
  modelfile=$(mktemp)
  printf 'FROM %s\n' "$file" > "$modelfile"
  ollama create "$match" -f "$modelfile"
  rm -f "$modelfile"
  # ollama stores blobs content-addressed, so the imported blob must
  # now sit under the very digest that identified the file; anything
  # else means the import mangled the artifact
  /usr/lib/llmd/llmd-model-verify "$match" || {
    echo "REFUSING to keep the import: stored blob does not match the catalog digest" >&2
    ollama rm "$match" 2>/dev/null || true
    exit 1
  }
  echo "imported: $match"
  if [[ "$serve" == "--use" ]]; then
    # serving guards apply here exactly as in cmd_use: the file may
    # arrive on any machine, but an embedding model must not become
    # the chat model and a giant must not be served on a box it would
    # freeze (the import itself is kept either way)
    local irole
    irole=$(jq -r --arg id "${match%%:*}" \
      '.models[] | select(.id == $id) | .role? // empty' "$CATALOG")
    if [[ "$irole" == "embedding" ]]; then
      echo "$match is an embedding model and cannot be the served chat model." >&2
      echo "it is imported; call /v1/embeddings with it, the chat model stays in place" >&2
      exit 1
    fi
    check_ram_floor "$match"
    echo "$match" > /etc/llmd/model
    echo "now serving: $match"
  else
    echo "serve it with: sibilla model use $match (already local, no download)"
  fi
}

cmd_info() {
  # shellcheck source=/dev/null
  . /usr/lib/llmd/sibilla-style
  local model="${1:-$CURRENT}"
  [[ -n "$model" ]] || { echo "no model served and none given" >&2; exit 1; }
  s_hdr "model info"

  # the signed catalog's view of it
  local centry
  centry=$(jq -r --arg id "${model%%:*}" --arg full "$model"     '[.models[] | select(.id == $id or .id == $full)][0] // empty' "$CATALOG")
  if [[ -n "$centry" ]]; then
    s_kv "family:"  "$(echo "$centry" | jq -r '.family')"
    s_kv "license:" "$(echo "$centry" | jq -r '.license')"
    s_kv "tier:"    "$(echo "$centry" | jq -r '.tier')$(echo "$centry" | jq -r 'if .source? == "registry" then " (registry source)" else "" end')"
  else
    s_kv "catalog:" "not a catalog entry" "$(s_warn)"
  fi

  if [[ "$ENGINE" == "vllm" ]]; then
    s_rule
    echo "engine vllm serves the model as published on Hugging Face;"
    echo "parameters and context are on the model's HF page. The"
    echo "engine-level card below is an ollama feature."
    return 0
  fi

  # the engine's own card: /api/show reads the GGUF metadata
  local show
  show=$(curl -s -m 10 http://127.0.0.1:11434/api/show \
    -d "$(jq -n --arg m "$model" '{model: $m}')" 2>/dev/null || true)
  if ! echo "$show" | jq -e '.details' >/dev/null 2>&1; then
    s_kv "engine:" "no card (model not in the local store: pull or use it first)" "$(s_warn)"
    return 0
  fi
  s_rule
  s_kv "arch:"      "$(echo "$show" | jq -r '.model_info["general.architecture"] // .details.family // "-"')"
  s_kv "params:"    "$(echo "$show" | jq -r '.details.parameter_size // "-"')"
  s_kv "quant:"     "$(echo "$show" | jq -r '.details.quantization_level // "-"')"
  s_kv "context:"   "$(echo "$show" | jq -r '[.model_info | to_entries[] | select(.key | endswith(".context_length")) | .value][0] // "-"') tokens (training limit)"
  s_kv "embedding:" "$(echo "$show" | jq -r '[.model_info | to_entries[] | select(.key | endswith(".embedding_length")) | .value][0] // "-"') dims"

  # runtime: what the appliance actually does with it
  s_rule
  local ctx="8192 (appliance default)"
  if [[ -r /etc/systemd/system/ollama.service.d/zz-context.conf ]]; then
    local c
    c=$(grep -oP 'OLLAMA_CONTEXT_LENGTH=\K[0-9]+' /etc/systemd/system/ollama.service.d/zz-context.conf || true)
    [[ -n "$c" ]] && ctx="$c (override: sibilla model context)"
  fi
  s_kv "serving:" "$([[ "$model" == "$CURRENT" ]] && echo "yes, this is the served model" || echo "no (served: ${CURRENT:-none})")"
  s_kv "window:"  "$ctx"
  local resident
  resident=$(curl -s -m 5 http://127.0.0.1:11434/api/ps 2>/dev/null     | jq -r --arg m "$model" '.models[]? | select(.name == $m) | "resident, " + (if .size > 0 then ((.size_vram * 100 / .size | floor | tostring) + "% on gpu") else "-" end)' || true)
  s_kv "memory:"  "${resident:-not resident (loads on first request; sibilla mem shows the split)}"
  echo
  echo "measured speed is sibilla bench's job: median tokens/s and"
  echo "time to first token, through the gateway with auth included"
}

cmd_rm() {
  need_root
  local model="$1"
  if [[ -n "$CURRENT" && "$model" == "$CURRENT" ]]; then
    echo "refusing to remove the served model; switch first with: sibilla model use ID" >&2
    exit 1
  fi
  # the ollama CLI panics without HOME when run over ssh/sudo
  export HOME="${HOME:-/root}"
  case "$ENGINE" in
    ollama)
      ollama rm "$model"
      ;;
    vllm)
      # vllm models live in the shared HF cache; the repo id maps to
      # a models--org--name directory inside hub/
      local dir="/var/lib/llmd/models/hf/hub/models--${model//\//--}"
      [[ -d "$dir" ]] || { echo "no local files for $model" >&2; exit 1; }
      rm -rf "$dir"
      ;;
  esac
  echo "removed: $model"
}

cmd_prune() {
  need_root
  export HOME="${HOME:-/root}"
  local removed=0
  case "$ENGINE" in
    ollama)
      while IFS= read -r m; do
        [[ -z "$m" || "$m" == "$CURRENT" ]] && continue
        ollama rm "$m" && removed=$((removed + 1))
      done < <(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}')
      ;;
    vllm)
      local keep="models--${CURRENT//\//--}"
      local d
      for d in /var/lib/llmd/models/hf/hub/models--*; do
        [[ -e "$d" ]] || continue
        [[ "$(basename "$d")" == "$keep" ]] && continue
        rm -rf "$d"
        removed=$((removed + 1))
      done
      ;;
  esac
  echo "removed $removed model(s); kept: ${CURRENT:-none}"
  du -sh /var/lib/llmd/models 2>/dev/null || true
}

case "${1:-}" in
  status) cmd_status ;;
  list)   cmd_list ;;
  use)    [[ $# -ge 2 ]] || usage; cmd_use "$2" ;;
  pull)   [[ $# -ge 2 ]] || usage; cmd_pull "$2" ;;
  import) [[ $# -ge 2 ]] || usage; cmd_import "$2" "${3:-}" ;;
  rm)     [[ $# -ge 2 ]] || usage; cmd_rm "$2" ;;
  prune)  cmd_prune ;;
  info)   shift; cmd_info "${1:-}" ;;
  context) shift; cmd_context "${1:-}" ;;
  warm)    shift; cmd_warm "${1:-}" ;;
  cache)   shift; cmd_cache "${1:-}" ;;
  *)      usage ;;
esac
