#!/usr/bin/env bash
# sibilla: single entry point for SibillaOS administration.
# The sibilla-* commands keep working as aliases.
set -euo pipefail

usage() {
  cat <<USAGE
usage: sibilla COMMAND [ARGS]

  setup          turn this Ubuntu machine into an LLM appliance:
                 detect hardware, install the engine, serve the API
  status         health view: engine, served models, disk, GPU, gateway
  model ...      list, download, import from file, switch and remove
  tls ...        switch the gateway between HTTP and HTTPS
  key ...        manage the gateway API keys (list, add, revoke, rotate)
  metrics ...    Prometheus endpoint on the gateway, on or off
  webui ...      enable or disable the Open WebUI chat interface
  mcp ...        expose the local model to MCP clients, on or off
  fetch          the machine at a glance (neofetch-style)
  mem            where the memory went: RAM, VRAM, resident models
  backup [FILE]  the machine configuration in one archive (keys included)
  restore FILE   put a backup back and re-enable what it says was on
  speech ...     local speech-to-text at /v1/audio/transcriptions
  transcribe F   transcribe an audio file from the CLI (--srt, --vtt)
  rerank ...     local reranking at /v1/rerank
  guard ...      screen chat requests with a guard model
  oidc ...       OIDC login for the WebUI (bring your own provider)
  kernel ...     kernel stack: GA by default, HWE as deliberate opt-in
  fleet ...      apply, check and status across many machines (SSH)
  apply          reconcile the machine onto a declared profile file
                 (export prints the current state; check audits drift,
                 hand edits, model digest and key permissions)
  connect        print client configuration for editors and agents
                 (--write places Continue and aider configs; --env,
                 --mcp and --snippet emit framework-ready formats)
  bench          measure this machine: first token latency, tokens/s
  doctor         paste-ready diagnostic report, no secrets included
  remove         clean teardown: only what SibillaOS installed goes

Run a command without arguments for its own usage.
USAGE
  exit 1
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  setup)   exec /usr/lib/llmd/sibilla-setup "$@" ;;
  status)  exec /usr/lib/llmd/sibilla-status "$@" ;;
  model)   exec sibilla-model "$@" ;;
  tls)     exec sibilla-tls "$@" ;;
  key)     exec sibilla-key "$@" ;;
  metrics) exec sibilla-metrics "$@" ;;
  webui)   exec sibilla-webui "$@" ;;
  mcp)     exec sibilla-mcp "$@" ;;
  fetch)   exec sibilla-fetch "$@" ;;
  mem)     exec /usr/lib/llmd/sibilla-mem "$@" ;;
  speech)  exec sibilla-speech "$@" ;;
  transcribe) exec sibilla-transcribe "$@" ;;
  rerank)  exec sibilla-rerank "$@" ;;
  guard)   exec sibilla-guard "$@" ;;
  oidc)    exec sibilla-oidc "$@" ;;
  kernel)  exec /usr/lib/llmd/sibilla-kernel "$@" ;;
  apply)   exec /usr/lib/llmd/sibilla-apply "$@" ;;
  fleet)   exec /usr/lib/llmd/sibilla-fleet "$@" ;;
  connect) exec sibilla-connect "$@" ;;
  bench)   exec /usr/lib/llmd/sibilla-bench "$@" ;;
  doctor)  exec /usr/lib/llmd/sibilla-doctor "$@" ;;
  backup)  exec /usr/lib/llmd/sibilla-backup backup "$@" ;;
  restore) exec /usr/lib/llmd/sibilla-backup restore "$@" ;;
  remove)  exec /usr/lib/llmd/sibilla-remove "$@" ;;
  *)       usage ;;
esac
